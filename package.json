{
  "name": "gantry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "tauri": "tauri",
    "bindings": "UPDATE_BINDINGS=1 cargo test -p gantry-core --test bindings",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --ignore-pattern \"src/testing/lint-probe/**\" && eslint --max-warnings 0 \"src/**/*.{html,ts}\" && stylelint --max-warnings 0 --ignore-pattern \"src/testing/lint-probe/**\" \"src/**/*.{css,ts}\"",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "changelog": "git-cliff -c cliff.toml -o CHANGELOG.md"
  },
  "dependencies": {
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@gravionlabs/helix-ag-grid": "^22.11.0",
    "@gravionlabs/helix-desktop": "^22.11.0",
    "@gravionlabs/helix-ui": "^22.11.0",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-store": "^2.5.1",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ag-grid-angular": "^36.3.0",
    "ag-grid-community": "^36.3.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/template-parser": "22.5.0",
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@gravionlabs/helix-lint": "22.11.0",
    "@tauri-apps/cli": "^2",
    "angular-eslint": "22.5.0",
    "eslint": "^10.15.0",
    "happy-dom": "^21.0.4",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "postcss-angular": "2.0.0",
    "stylelint": "18.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.11.0"
}
